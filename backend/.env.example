# GRADSKOOL Backend — Complete Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── DJANGO CORE ────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-django-secret-key-minimum-50-chars
JWT_SIGNING_KEY=separate-key-for-jwt-signing-also-minimum-50-chars
DJANGO_SETTINGS_MODULE=config.settings.development

# ── DATABASE ───────────────────────────────────────────────────────────────────
# Development (SQLite — no config needed, auto-creates db.sqlite3)
# Production (Supabase PostgreSQL — copy from Supabase dashboard)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── HOSTS / CORS ───────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,api.gradskool.in,gradskool-backend.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://gradskool.in,https://www.gradskool.in
FRONTEND_URL=http://localhost:3000

# ── EMAIL — RESEND ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=GRADSKOOL <hello@gradskool.in>

# ── AUTH — GOOGLE OAUTH ────────────────────────────────────────────────────────
GOOGLE_OAUTH2_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ── PAYMENTS — RAZORPAY ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VIDEO — BUNNY STREAM ───────────────────────────────────────────────────────
BUNNY_LIBRARY_ID=123456
BUNNY_TOKEN_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BUNNY_STREAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUNNY_PULL_ZONE_URL=https://gradskool-pullzone.b-cdn.net
BUNNY_STORAGE_ZONE=gradskool-storage
BUNNY_STORAGE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Storage — PDF page images. Same Supabase project as your DATABASE_URL,
# just its Storage product. Storage → New bucket → "pdf-pages" → Private.
# Project Settings → API for the URL and service_role key (not anon).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=pdf-pages

# ── AI — OPENAI (Whisper + GPT-4o-mini) ───────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WHATSAPP — INTERAKT (optional, paid service) ──────────────────────────────
# WhatsApp notifications are disabled by default.
# To enable: sign up at https://app.interakt.ai, get API key, get templates approved
# INTERAKT_API_KEY=your-interakt-api-key-here

# ── CACHE / CELERY — UPSTASH REDIS ────────────────────────────────────────────
# Get from: https://console.upstash.com → Create Database → Copy REST URL
UPSTASH_REDIS_URL=rediss://default:xxxxxxxx@xxxx.upstash.io:6379

# ── ERROR TRACKING — SENTRY ────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxx@oxxxx.ingest.sentry.io/xxxxxxx

# ── ADMIN ALERTS ───────────────────────────────────────────────────────────────
# Comma-separated name:email pairs
ADMINS=Admin:admin@gradskool.in
