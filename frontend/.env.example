# GRADSKOOL Frontend — Environment Variables
# Copy to .env.local. Never commit .env.local to git.

# ── API ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Same Client ID as backend (public key — safe to expose)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── SENTRY ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxx.ingest.sentry.io/xxxxxxx

# ── RAZORPAY (M4) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
