# GRADSKOOL Frontend — Environment Variables
# Copy to .env.local (never commit .env.local to git)

# ── API ────────────────────────────────────────────────────────────────────────
# Development: Django running locally
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production: deployed Railway backend
# NEXT_PUBLIC_API_URL=https://api.gradskool.in/api/v1

# ── ANALYTICS ─────────────────────────────────────────────────────────────────
# Get from: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── ERROR TRACKING ─────────────────────────────────────────────────────────────
# Get from: https://sentry.io → Settings → Projects → DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oxxxx.ingest.sentry.io/xxxxxxx

# ── PAYMENTS (Razorpay public key — safe to expose) ───────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# ── SITE URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_SITE_URL=https://gradskool.in
